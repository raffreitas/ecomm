<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>f36c63a0-726e-4709-84c9-c6700e884fc2</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..\..</DockerfileContext>
        <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ecomm.Payments.Application\Ecomm.Payments.Application.csproj" />
      <ProjectReference Include="..\Ecomm.Payments.Infrastructure\Ecomm.Payments.Infrastructure.csproj" />
      <ProjectReference Include="..\..\..\building-blocks\Ecomm.Messaging\Ecomm.Messaging.csproj" />
      <ProjectReference Include="..\..\..\building-blocks\Ecomm.ServiceDefaults\Ecomm.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
